<%- include("../partials/head", { title: `${character.name} | Rick & Morty` }) %>


<%- include("../partials/navbar", { activePage: "characters" }) %>


<!-- ================= MAIN ================= -->

<main class="details-page">

    <div class="details-container">


        <!-- Back Button -->

        <a href="/characters" class="back-button">
            <span>←</span>
            Back to Characters
        </a>


        <!-- Character Details -->

        <section class="character-details-card">


            <!-- Character Image -->

            <div class="details-image-wrapper">

                <div class="details-image-glow"></div>

                <img
                    src="<%= character.image %>"
                    alt="<%= character.name %>"
                    class="details-image"
                >

            </div>


            <!-- Character Information -->

            <div class="details-content">


                <div class="details-heading">

                    <div>

                        <span class="details-label">
                            CHARACTER PROFILE
                        </span>

                        <h1>
                            <%= character.name %>
                        </h1>

                    </div>


                    <div class="details-status">

                        <span
                            class="status-dot <%= character.status.toLowerCase() %>"
                        ></span>

                        <%= character.status %>

                    </div>

                </div>


                <p class="details-description">
                    Welcome to the Rick & Morty universe.
                    Explore the details of this character
                    and discover where they come from.
                </p>


                <!-- ================= INFORMATION GRID ================= -->

                <div class="details-info-grid">


                    <!-- Species -->

                    <div class="info-box">

                        <span class="info-icon">
                            🧬
                        </span>

                        <div>

                            <span class="info-label">
                                Species
                            </span>

                            <span class="info-value">
                                <%= character.species %>
                            </span>

                        </div>

                    </div>


                    <!-- Gender -->

                    <div class="info-box">

                        <span class="info-icon">
                            ⚥
                        </span>

                        <div>

                            <span class="info-label">
                                Gender
                            </span>

                            <span class="info-value">
                                <%= character.gender %>
                            </span>

                        </div>

                    </div>


                    <!-- Origin -->

                    <div class="info-box">

                        <span class="info-icon">
                            🌍
                        </span>

                        <div>

                            <span class="info-label">
                                Origin
                            </span>


                            <% if (originId) { %>

                                <a
                                    href="/locations/<%= originId %>"
                                    class="info-value info-link"
                                >
                                    <%= character.origin.name %>
                                </a>

                            <% } else { %>

                                <span class="info-value">
                                    <%= character.origin.name %>
                                </span>

                            <% } %>

                        </div>

                    </div>


                    <!-- Last Location -->

                    <div class="info-box">

                        <span class="info-icon">
                            📍
                        </span>

                        <div>

                            <span class="info-label">
                                Last Location
                            </span>


                            <% if (locationId) { %>

                                <a
                                    href="/locations/<%= locationId %>"
                                    class="info-value info-link"
                                >
                                    <%= character.location.name %>
                                </a>

                            <% } else { %>

                                <span class="info-value">
                                    <%= character.location.name %>
                                </span>

                            <% } %>

                        </div>

                    </div>


                    <!-- Episodes Count -->

                    <div class="info-box">

                        <span class="info-icon">
                            🎬
                        </span>

                        <div>

                            <span class="info-label">
                                Episodes
                            </span>

                            <span class="info-value">
                                <%= character.episode.length %>
                            </span>

                        </div>

                    </div>


                    <!-- Character ID -->

                    <div class="info-box">

                        <span class="info-icon">
                            🆔
                        </span>

                        <div>

                            <span class="info-label">
                                Character ID
                            </span>

                            <span class="info-value">
                                #<%= character.id %>
                            </span>

                        </div>

                    </div>


                </div>


                <!-- ================= EPISODES ================= -->

                <div class="character-episodes-section">


                    <div class="character-episodes-heading">

                        <h2>
                            Episodes
                        </h2>

                        <span>
                            <%= character.episode.length %>
                            appearances
                        </span>

                    </div>


                    <div class="character-episodes-grid">


                        <% if (episodes && episodes.length > 0) { %>


                            <% episodes.forEach(episode => { %>

                                <a
                                    href="/episodes/<%= episode.id %>"
                                    class="character-episode-card"
                                >


                                    <!-- Episode Icon -->

                                    <div class="character-episode-icon">
                                        ▶
                                    </div>


                                    <!-- Episode Info -->

                                    <div class="character-episode-info">

                                        <span class="character-episode-code">
                                            <%= episode.episode %>
                                        </span>


                                        <h3>
                                            <%= episode.name %>
                                        </h3>


                                        <span class="character-episode-date">
                                            <%= episode.air_date %>
                                        </span>

                                    </div>


                                    <!-- Arrow -->

                                    <span class="character-episode-arrow">
                                        →
                                    </span>


                                </a>

                            <% }) %>


                        <% } else { %>


                            <div class="no-character-episodes">

                                No episode data available.

                            </div>


                        <% } %>


                    </div>


                </div>


            </div>

        </section>


    </div>

</main>


<!-- ================= DECORATIVE ELEMENTS ================= -->

<div class="portal-decoration portal-one"></div>

<div class="portal-decoration portal-two"></div>

<div class="space-rock rock-one"></div>

<div class="space-rock rock-two"></div>


<%- include("../partials/footer") %>